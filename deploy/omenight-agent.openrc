#!/sbin/openrc-run

name="omenight-agent"
description="Omenight reverse tunnel agent"

: ${OMENIGHT_OPTS:="-relay relay.example.com:2223 -name CHANGE_ME"}

command="/usr/local/bin/omenight-agent"
command_args="run ${OMENIGHT_OPTS}"
command_user="omenight"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/omenight-agent.log"
error_log="/var/log/omenight-agent.log"

depend() {
	need net
	after firewall
}

start_pre() {
	checkpath --directory --mode 0750 --owner omenight:omenight /var/log
}
