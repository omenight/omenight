[Unit]
Description=Omenight relay
After=network-online.target
Wants=network-online.target

[Service]
# Root so the daemon and the root CLI share the state file. The bounding set
# keeps only interface, route and rule management.
User=root
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StateDirectory=omenight
StateDirectoryMode=0700
RuntimeDirectory=omenight
ExecStart=/usr/local/bin/omenight-relay serve \
	-state /var/lib/omenight/state.json \
	-socket /run/omenight/control.sock
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
